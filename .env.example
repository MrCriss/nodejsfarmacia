
# Firebase Configuration (Opcional - para autenticación y base de datos en el futuro)
# Obtén estos valores de tu Firebase Console
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# ============================================
# CONTACT FORM - EMAIL
# ============================================
# Email de contacto predeterminado
VITE_CONTACT_EMAIL=contacto@farmaciabonita.cl

# EmailJS Configuration (Para envío automático de emails)
# Obtén estas credenciales en: https://www.emailjs.com/
# Dejar en blanco para usar fallback a Gmail (abre Gmail en el navegador)
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# ============================================
# WHATSAPP
# ============================================
# Número de WhatsApp en formato internacional
VITE_WHATSAPP_NUMBER=+56912345678

# ============================================
# URLS PERMITIDAS (CORS)
# ============================================
VITE_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://farmaciabonita-b2f5f.web.app,https://farmaciabonita-b2f5f.firebaseapp.com

# ============================================
# AMBIENTE
# ============================================
# development = Desarrollo local
# production = Producción en Firebase
NODE_ENV=development

# ============================================
# LOG LEVEL
# ============================================
# debug, info, warn, error
VITE_LOG_LEVEL=info

